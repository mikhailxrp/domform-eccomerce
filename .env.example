# Скопируй этот файл в .env и заполни значения
# .env никогда не коммитить в git

# Окружение: local | production
APP_ENV=local
APP_URL=http://localhost

# База данных
DB_HOST=localhost
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Логгер
APP_LOG_LEVEL=error

# Первый администратор — создаётся один раз: php database/seed.php
# Повторный запуск при уже существующем ADMIN_EMAIL ничего не меняет.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email
# MAIL_DRIVER=log — ссылка/письмо пишется в storage/logs/app.log (локально)
# MAIL_DRIVER=mail — отправка через PHP mail() (shared-хостинг, FR-AUTH-003)
MAIL_DRIVER=log
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=ДомФорм

# SMTP — не используется MAIL_DRIVER=log/mail, оставлено для будущего
# провайдера, если понадобится
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# ИИ-помощники (`.docs/phases/phase-9.md`, `BR-AI-001` правило 3) —
# провайдер выбирается по классу задачи, не по помощнику. Пустой ключ
# класса = класс недоступен, помощники этого класса отключаются без
# ошибки (`FR-AI-*` «при недоступности»).

# Класс «обезличенные данные» (FR-AI-001, FR-AI-002) — Claude через
# OpenRouter. Ключ — в личном кабинете openrouter.ai/keys, без ролей и
# folder id. Модель — точный слаг с openrouter.ai/models (не "latest":
# смена версии Claude должна быть осознанной правкой этой строки).
AI_PROVIDER_ANONYMOUS=openrouter
AI_OPENROUTER_KEY=
AI_OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Класс «пользовательский ввод» (FR-AI-003, FR-AI-004) — YandexGPT,
# российский провайдер по умолчанию. AI_YANDEX_KEY — API-ключ (не IAM-
# токен и не статический ключ доступа) сервисного аккаунта с ролью
# ai.languageModels.user, желательно со scope
# yc.ai.languageModels.execute. AI_YANDEX_FOLDER_ID — id каталога
# (folder), не сервисного аккаунта.
AI_PROVIDER_USER_INPUT=yandexgpt
AI_YANDEX_KEY=
AI_YANDEX_FOLDER_ID=
AI_YANDEX_MODEL=yandexgpt/latest

# Демо-режим Консультанта в чате (не часть ТЗ — ограничение для демо/
# портфолио-стенда): true — не более 7 вопросов на один диалог
# (`AI_CHAT_DEMO_LIMIT`, `src/Core/AiChat.php`), первый ответ диалога
# начинается с приветствия про демо-версию и лимит. false или
# отсутствие переменной — лимита и приветствия нет.
LIMIT_REQUESTS=false
