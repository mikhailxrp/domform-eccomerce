# Скопируй этот файл в .env и заполни значения
# .env никогда не коммитить в git

# Окружение: local | production
APP_ENV=local
APP_URL=http://localhost

# База данных
DB_HOST=localhost
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Логгер
APP_LOG_LEVEL=error

# Первый администратор — создаётся один раз: php database/seed.php
# Повторный запуск при уже существующем ADMIN_EMAIL ничего не меняет.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email
# MAIL_DRIVER=log — ссылка/письмо пишется в storage/logs/app.log (локально)
# MAIL_DRIVER=mail — отправка через PHP mail() (shared-хостинг, FR-AUTH-003)
MAIL_DRIVER=log
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=ДомФорм

# SMTP — не используется MAIL_DRIVER=log/mail, оставлено для будущего
# провайдера, если понадобится
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
